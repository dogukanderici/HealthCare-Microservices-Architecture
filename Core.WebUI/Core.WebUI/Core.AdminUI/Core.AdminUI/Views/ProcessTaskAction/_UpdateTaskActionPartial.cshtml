@model ProcessTaskActionUpdateModel

@{
    ViewData["Title"] = "Aksiyon Güncelleme";
    string processTaskActionEndpoint = Configuration["ApiSetting:WorkflowEngine:UIUrl:ProcessTaskAction"];
}

<div class="p-3 p-md-4 text-start">
    <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold text-dark mb-1">Aksiyon Güncelleme</h4>
            <p class="text-muted small mb-0">Süreç adımına ait aksiyon adını ve durumu belirleyin.</p>
        </div>
    </div>

    <form id="update-process-task-action" asp-controller="ProcessTaskAction" asp-action="Update" asp-route-id="@Model.ModelData.Id" method="post">

        @Html.HiddenFor(x => Model.ModelData.Id)
        @Html.HiddenFor(x => Model.ModelData.ProcessTaskId)
        @Html.HiddenFor(x => Model.ModelData.ActionId)

        <div class="row g-4 align-items-center">
            <div class="col-md-6">
                <label asp-for="@Model.ModelData.ActionName" class="form-label fw-semibold text-secondary small text-uppercase">
                    Aksiyon Adı
                </label>
                <div class="input-group">
                    <input asp-for="@Model.ModelData.ActionName"
                           type="text"
                           class="form-control border-start-0 ps-0"
                           aria-required="true"
                           placeholder="Örn: Kaydet" />
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small text-uppercase d-block">
                    Durum
                </label>
                <div class="capsule-switch">
                    <input type="radio" id="task-action-status-active" asp-for="@Model.ModelData.IsActive" value="true">
                    <label for="task-action-status-active"><i class="fa-solid fa-check"></i> Aktif</label>

                    <input type="radio" id="task-action-status-pasive" asp-for="@Model.ModelData.IsActive" value="false">
                    <label for="task-action-status-pasive"><i class="fa-solid fa-cancel"></i> Pasif</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3 border-top">
            <button id="update-task-action-cancel-btn"
                    type="button"
                    onclick="Swal.close()"
                    class="btn btn-light text-secondary fw-medium px-4 py-2">
                Vazgeç
            </button>

            <button id="update-task-action-submit"
                    type="submit"
                    class="btn btn-primary fw-medium px-4 py-2 shadow-sm">
                <i class="fa-regular fa-floppy-disk me-1"></i>
                <span id="api-task-action-submit">Güncelle</span>
            </button>
        </div>
    </form>
</div>