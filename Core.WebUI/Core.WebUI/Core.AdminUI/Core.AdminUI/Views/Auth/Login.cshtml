@{
    ViewData["Title"] = "Hoşgeldiniz - Giriş Yap";
    Layout = "~/Views/AuthLayout/Index.cshtml";
}

<div class="login-wrapper w-full max-w-[420px] px-6">
    <div class="login-card">
        <!-- Header -->
        <div class="text-center mb-10">
            <div class="w-16 h-16 bg-indigo-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-indigo-500/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2 tracking-tight">Hoşgeldiniz</h1>
            <p class="text-slate-400 text-sm">Devam etmek için lütfen giriş yapınız</p>
        </div>

        <!-- Form -->
        <form id="loginForm" autocomplete="off">

            <!-- Email Input -->
            <div class="input-group">
                <!-- Note: space character in placeholder is required for :placeholder-shown trick to work -->
                <input type="email" id="email" class="input-control" placeholder=" " required autocomplete="off">
                <label for="email" class="input-label">E-Posta</label>
                <div class="input-glow"></div>
            </div>

            <!-- Password Input -->
            <div class="input-group">
                <input type="password" id="password" class="input-control" placeholder=" " required>
                <label for="password" class="input-label">Şifre</label>
                <div class="input-glow"></div>
            </div>

            <!-- Extras (Remember Me & Forgot Password) -->
            <div class="flex items-center justify-between mb-8">
                <label class="checkbox-container">
                    <input type="checkbox">
                    <div class="checkmark">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span class="text-sm text-slate-400">Beni Hatırla</span>
                </label>

                <a href="/auth/changepassword" class="text-sm text-indigo-400 hover:text-indigo-300 transition-colors">Şifrenizi unuttunuz mu?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="login-btn" id="submitBtn">
                <span class="btn-text">Giriş Yap</span>
                <div class="loader"></div>
            </button>
        </form>

        <!-- Footer -->
        <p class="text-center text-sm text-slate-400 mt-8">
            Henüz bir hesabınız yok mu?
            <a href="/auth/register" class="text-indigo-400 hover:text-indigo-300 font-semibold transition-colors">Hesap Oluştur</a>
        </p>
    </div>

    <p class="text-left text-sm text-slate-400 mt-8">
        Giriş yaparak
        <button class="btn-terms text-indigo-400 hover:text-indigo-300 font-semibold transition-colors">Kullanım Koşulları</button>nı ve
        <button class="btn-privacy text-indigo-400 hover:text-indigo-300 font-semibold transition-colors">Gizlilk Politasını</button>
        kabul etmiş olursunuz.
    </p>
</div>