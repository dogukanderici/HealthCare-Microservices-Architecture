@model ProcessDefinitionResultModel<IReadOnlyCollection<ProcessDefinitionResultDto>>

@{
    ViewData["Title"] = "Süreç Tanımları";
    Layout = "~/Views/UILayout/Index.cshtml";
    string processEndpoint = Configuration["ApiSetting:WorkflowEngine:UIUrl:ProcessDefinition"];
}

<div class="row row-tight" style="margin-top: 16px;">
    <div class="col-md-12">
        <section class="m-card" aria-labelledby="process-definition-title">
            <header class="m-card__header">
                <div>
                    <h2 class="m-card__title" id="process-definition-title">Süreç Tanımları</h2>
                    <p class="m-card__subtitle">Süreç isimlerini ve süreçlere ait diğer tanımlar</p>
                </div>
            </header>
            
            <div class="table-data__tool">
                <form id="process-query-filter" asp-controller="Process" asp-action="Index" method="post">
                    <div class="table-data__tool-left">
                        <div class="select-wrapper">
                            <select class="form-select" aria-label="Filter properties">
                                <option selected>- Seçiniz -</option>
                                <option>Dynamic Policy</option>
                                <option>Dynamic Role</option>
                                <option>Process Definition</option>
                                <option>Process Task</option>
                            </select>
                        </div>
                        <div class="select-wrapper">
                            <select class="form-select" aria-label="İstek Tipi">
                                <option value="" selected>- Seçiniz -</option>
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                            </select>
                        </div>
                        <button class="au-btn-filter" type="submit">
                            <i class="fa-solid fa-filter" aria-hidden="true"></i> Ara
                        </button>
                    </div>
                </form>
                <div class="table-data__tool-right">
                    <button type="button"
                            class="au-btn au-btn--green au-btn--small"
                            onclick="confirmWindowAsync('@Url.Action("Create", "Process")','create')"
                            title="Ekle">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i> Yeni Süreç Ekle
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-data2">
                    <thead>
                        <tr>
                            <th>Süreç Adı</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ModelData)
                        {
                            <tr>
                                <td>@item.ProcessName</td>
                                @if (@item.IsActive)
                                {
                                    <td>
                                        <section class="notice-card--success">
                                            <span class="notice-card__icon"><i class="fa-solid fa-circle-check"></i></span>
                                        </section>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <section class="notice-card--danger">
                                            <span class="notice-card__icon"><i class="fa-solid fa-circle-xmark"></i></span>
                                        </section>
                                    </td>
                                }
                                <td>
                                    <div class="table-data-feature">
                                        <a href="@processEndpoint/@item.Id" class="item btn-update" type="button" data-bs-toggle="tooltip" title="Yeni Süreç Adımı Ekle"><i class="fa-solid fa-square-plus"></i></a>
                                        @* <a href="@processEndpoint/update/@item.Id"
                                           class="item btn-update"
                                           type="button"
                                           data-bs-toggle="tooltip"
                                           title="Güncelle">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a> *@
                                        <button class="item btn-update"
                                                type="button"
                                                onclick="confirmWindowAsync('@Url.Action("UpdatePartial", "Process", new { id = item.Id })','update')"
                                                data-bs-toggle="tooltip"
                                                title="Güncelle">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        @* <a href="@processEndpoint/delete/@item.Id"
                                           class="item btn-delete"
                                           type="button"
                                           data-bs-toggle="tooltip"
                                           title="Sil">
                                            <i class="fa-solid fa-trash"></i>
                                        </a> *@
                                        <button class="item btn-delete"
                                                type="button"
                                                onclick="confirmWindowAsync('@Url.Action("DeletePartial", "Process", new { id = item.Id })')"
                                                data-bs-toggle="tooltip"
                                                title="Sil">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>