@model Guid

<form id="delete-process" asp-controller="Process" asp-action="Delete" asp-route-id="@Model" method="post">

    <div class="text-center mb-4">
        <p class="fs-5 text-dark mb-1">Bu veriyi silmek istiyor musunuz?</p>
        <small class="text-muted">Bu işlem geri alınamaz.</small>
    </div>

    <div class="d-flex justify-content-center align-items-center gap-3">
        <button id="delete-process-cancel"
                type="button"
                onclick="Swal.close()"
                class="btn btn-outline-secondary px-4 py-2">
            <i class="fa-regular fa-circle-xmark me-1"></i>
            <span>Vazgeç</span>
        </button>

        <button id="delete-process-submit"
                type="submit"
                class="btn btn-danger px-4 py-2">
            <i class="fa-regular fa-trash-can me-1"></i>
            <span id="api-policy-submit-amount">Evet, Sil</span>
        </button>
    </div>
</form>