@using Core.AdminUI.Commons.Extensions
@model DynamicPolicyResultModel<IReadOnlyCollection<DynamicPolicyResultDto>>

@{
    ViewData["Title"] = "Dinamik Yetkilendirme";
    Layout = "~/Views/UILayout/Index.cshtml";
    string methodeType = "notice-card--info";
    string notificationJson = TempData[TempDataExtension.NotificationKey] as string;
}

<div class="row row-tight" style="margin-top: 16px;">
    <div class="col-md-12">
        <section class="m-card" aria-labelledby="dynamicpolicy-title">
            <header class="m-card__header">
                <div>
                    <h2 class="m-card__title" id="dynamicpolicy-title">Dinamik Api Yetkilendirme</h2>
                    <p class="m-card__subtitle">Api endpoint erişim sağlayacak kullanıcı rolleri tanımları</p>
                </div>
            </header>
            <div class="table-data__tool">
                <div class="table-data__tool-left">
                    <div class="select-wrapper">
                        <select class="form-select" aria-label="Filter properties">
                            <option selected>- Seçiniz -</option>
                            <option>Dynamic Policy</option>
                            <option>Dynamic Role</option>
                            <option>Process Definiiton</option>
                            <option>Process Task</option>
                        </select>
                    </div>
                    <div class="select-wrapper">
                        <select class="form-select" aria-label="İstek Tipi">
                            <option selected>- Seçiniz -</option>
                            <option>GET</option>
                            <option>POST</option>
                            <option>PUT</option>
                            <option>DELETE</option>
                        </select>
                    </div>
                    <button class="au-btn-filter" type="button">
                        <i class="fa-solid fa-filter" aria-hidden="true"></i> Ara
                    </button>
                </div>
                <div class="table-data__tool-right">
                    <a href="/dynamicpolicy/create" class="au-btn au-btn--green au-btn--small">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i> Yeni Yetki Ekle
                    </a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-data2">
                    <thead>
                        <tr>
                            <th>İstek Tipi</th>
                            <th>Endpoint</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ModelData)
                        {
                            <tr>
                                @if (item.Methode == "GET")
                                {
                                    methodeType = "notice-card--info";
                                }
                                else if (item.Methode == "POST")
                                {
                                    methodeType = "notice-card--success";
                                }
                                else if (item.Methode == "PUT")
                                {
                                    methodeType = "notice-card--warning";
                                }
                                else if (item.Methode == "DELETE")
                                {
                                    methodeType = "notice-card--danger";
                                }
                                
                                <td>
                                    <section class="@methodeType">
                                        <span class="w-auto notice-card__icon">@item.Methode</span>
                                    </section>
                                </td>

                                <td>@item.Endpoint</td>
                                @if (@item.IsActive)
                                {
                                    <td>
                                        <section class="notice-card--success">
                                            <span class="notice-card__icon"><i class="fa-solid fa-circle-check"></i></span>
                                        </section>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <section class="notice-card--danger">
                                            <span class="notice-card__icon"><i class="fa-solid fa-circle-xmark"></i></span>
                                        </section>
                                    </td>
                                }
                                <td>
                                    <div class="table-data-feature">
                                        <a href="/dynamicrole/@item.Id" class="item btn-update" type="button" data-bs-toggle="tooltip" title="Yeni Rol Ekle"><i class="fa-solid fa-square-plus"></i></a>
                                        <a href="/dynamicpolicy/update?id=@item.Id" class="item btn-update" type="button" data-bs-toggle="tooltip" title="Güncelle"><i class="fa-solid fa-pen-to-square"></i></a>
                                        @* <a href="/dynamicpolicy/delete?id=@item.Id" class="item btn-delete" type="button" data-bs-toggle="tooltip" title="Sil"><i class="fa-solid fa-trash"></i></a> *@
                                        <a href="javascript:void(0)"
                                           class="item btn-delete"
                                           type="button"
                                           data-bs-toggle="tooltip"
                                           title="Sil"
                                           data-id="@item.Id"
                                           data-endpoint="@item.Endpoint"
                                           data-methode="@item.Methode"
                                           data-isactive="@(item.IsActive ? "Aktif" : "Pasif")">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@await Html.PartialAsync("_DeletePolicyPartial")

@section Scripts {
    <script>

        var rawNotification = @Html.Raw(string.IsNullOrWhiteSpace(notificationJson) ? "null" : notificationJson);

        if (rawNotification) {

            document.addEventListener("DOMContentLoaded", function () {
                const payload = @Html.Raw(notificationJson);

                // 1. Konsola teknik detayları gruplanmış şekilde bas
                console.groupCollapsed(`%c[UI API Error] ${payload.statusCode} ${payload.statusText}`, "color: #ff4d4f; font-weight: bold;");
                console.error("Teknik Mesaj:", payload.technicalMessage || "Detay belirtilmemiş");
                console.info("Zaman (UTC):", payload.timestamp);
                console.debug("Ham Payload:", payload);
                console.groupEnd();

                // 2. Arayüze sadece kullanıcının anlayacağı sade pop-up'ı bas
                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        position: "top-end",
                        icon: payload.type,
                        text: payload.userMessage,
                        showConfirmButton: false,
                        timer: 1500
                    });
                }
            });
        }
        
    </script>

