@model DynamicPolicyResultModel<IReadOnlyCollection<DynamicPolicyResultDto>>

@{
    ViewData["Title"] = "Dinamik Yetkilendirme";
    Layout = "~/Views/UILayout/Index.cshtml";
    string methodeType = "notice-card--info";
    string dynamicPolicyEndpoint = Configuration["ApiSetting:WorkflowEngine:UIUrl:DynamicPolicy"];
    string dynamicRoleEndpoint = Configuration["ApiSetting:WorkflowEngine:UIUrl:DynamicRole"];
}

<div class="row row-tight" style="margin-top: 16px;">
    <div class="col-md-12">
        <section class="m-card" aria-labelledby="dynamicpolicy-title">
            <header class="m-card__header">
                <div>
                    <h2 class="m-card__title" id="dynamicpolicy-title">Dinamik Api Yetkilendirme</h2>
                    <p class="m-card__subtitle">Api endpoint erişim sağlayacak kullanıcı rolleri tanımları</p>
                </div>
            </header>
            
            <div class="table-data__tool">
                <form id="policy-filter-query" asp-controller="DynamicPolicy" asp-action="Index" method="post">
                    <div class="table-data__tool-left">
                        <div class="select-wrapper">
                            <select class="form-select" aria-label="Filter properties">
                                <option selected>- Seçiniz -</option>
                                <option>Dynamic Policy</option>
                                <option>Dynamic Role</option>
                                <option>Process Definition</option>
                                <option>Process Task</option>
                            </select>
                        </div>
                        <div class="select-wrapper">
                            <select asp-for="@Model.QueryFilter.Methode" class="form-select" aria-label="İstek Tipi">
                                <option value="" selected>- Seçiniz -</option>
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                            </select>
                        </div>
                        <button class="au-btn-filter" type="submit">
                            <i class="fa-solid fa-filter" aria-hidden="true"></i> Ara
                        </button>
                    </div>
                </form>
                <div class="table-data__tool-right">
                    <a href="@dynamicPolicyEndpoint/create" class="au-btn au-btn--green au-btn--small">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i> Yeni Yetki Ekle
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-data2">
                    <thead>
                        <tr>
                            <th>İstek Tipi</th>
                            <th>Endpoint</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ModelData)
                        {
                            <tr>
                                @if (item.Methode == "GET")
                                {
                                    methodeType = "notice-card--info";
                                }
                                else if (item.Methode == "POST")
                                {
                                    methodeType = "notice-card--success";
                                }
                                else if (item.Methode == "PUT")
                                {
                                    methodeType = "notice-card--warning";
                                }
                                else if (item.Methode == "DELETE")
                                {
                                    methodeType = "notice-card--danger";
                                }
                                
                                <td>
                                    <section class="@methodeType">
                                        <span class="w-auto notice-card__icon">@item.Methode</span>
                                    </section>
                                </td>

                                <td>@item.Endpoint</td>
                                @if (@item.IsActive)
                                {
                                    <td>
                                        <section class="notice-card--success">
                                            <span class="notice-card__icon"><i class="fa-solid fa-circle-check"></i></span>
                                        </section>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <section class="notice-card--danger">
                                            <span class="notice-card__icon"><i class="fa-solid fa-circle-xmark"></i></span>
                                        </section>
                                    </td>
                                }
                                <td>
                                    <div class="table-data-feature">
                                        <a href="@dynamicRoleEndpoint/@item.Id" class="item btn-update" data-bs-toggle="tooltip" title="Yeni Rol Ekle"><i class="fa-solid fa-square-plus"></i></a>
                                        <a href="@dynamicPolicyEndpoint/update?id=@item.Id" class="item btn-update" data-bs-toggle="tooltip" title="Güncelle"><i class="fa-solid fa-pen-to-square"></i></a>
                                        @* <a href="@dynamicPolicyEndpoint/delete?id=@item.Id" class="item btn-delete" data-bs-toggle="tooltip" title="Sil"><i class="fa-solid fa-trash"></i></a> *@
                                        <button class="item btn-delete"
                                                type="button"
                                                onclick="confirmWindowAsync('@Url.Action("DeletePartial", "DynamicPolicy", new { id = item.Id })')"
                                                data-bs-toggle="tooltip"
                                                title="Sil">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                        @* <a href="javascript:void(0)"
                                           class="item btn-delete"
                                           type="button"
                                           data-bs-toggle="tooltip"
                                           title="Delete"
                                           data-id="@item.Id"
                                           data-endpoint="@item.Endpoint"
                                           data-methode="@item.Methode"
                                           data-isactive="@(item.IsActive ? "Aktif" : "Pasif")">
                                            <i class="fa-solid fa-trash"></i>
                                        </a> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

