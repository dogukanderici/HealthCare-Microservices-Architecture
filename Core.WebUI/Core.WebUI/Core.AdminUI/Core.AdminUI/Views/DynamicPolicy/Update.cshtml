@model DynamicPolicyUpdateModel

@{
    Layout = "~/Views/UILayout/Index.cshtml";
    ViewData["Title"] = "Dinamik Yetkilendirme Güncelleme";
    string dynamicPolicyEndpoint = Configuration["ApiSetting:WorkflowEngine:UIUrl:DynamicPolicy"];
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">API Endpoint Güncelleme</div>
            <div class="card-body">
                <div class="card-title">
                    <h3 class="text-center title-2">API Bilgileri</h3>
                </div>
                <hr>
                <form id="update-api-policy" asp-controller="DynamicPolicy" asp-action="Update" method="post">

                    @Html.HiddenFor(x => x.ModelData.Id)

                    <div class="mb-3">
                        <label asp-for="@Model.ModelData.Endpoint" class="control-label mb-1">Endpoint</label>
                        <input asp-for="@Model.ModelData.Endpoint" type="text" class="form-control" aria-required="true" placeholder="/api/home">
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label asp-for="@Model.ModelData.Methode" class="control-label mb-1">HTTP Methode</label>
                            <div class="col-12">
                                <select id="api-methode" asp-for="@Model.ModelData.Methode" class="form-select">
                                    <option value="GET">GET</option>
                                    <option value="POST">POST</option>
                                    <option value="PUT">PUT</option>
                                    <option value="DELETE">DELETE</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-control-label">Durum</label>
                            <div class="col-12">
                                <div class="form-check form-check-inline">
                                    <input type="radio" id="endpoint-status-active" asp-for="@Model.ModelData.IsActive" value="true" class="form-check-input">
                                    <label asp-for="@Model.ModelData.IsActive" class="form-check-label">Aktif</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" id="endpoint-status-pasive" asp-for="@Model.ModelData.IsActive" value="false" class="form-check-input">
                                    <label asp-for="@Model.ModelData.IsActive" class="form-check-label">Pasif</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button id="api-policy-update" type="submit" class="btn btn-lg btn-info">
                            <i class="fa-regular fa-floppy-disk"></i>&nbsp;
                            <span id="api-policy-submit">Güncelle</span>
                        </button>
                        <a href="@dynamicPolicyEndpoint" id="api-policy-cancel" class="btn btn-lg btn-outline-secondary">
                            <i class="fa-regular fa-circle-xmark"></i>&nbsp;
                            <span id="api-policy-cancel">Vazgeç</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>