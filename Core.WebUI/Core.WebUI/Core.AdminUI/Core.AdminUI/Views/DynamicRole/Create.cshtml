@model DynamicRoleCreateModel

@{
    ViewData["Title"] = "Dinamik Yetki Yeni Rol Ekleme";
    Layout = "~/Views/UILayout/Index.cshtml";
    string methodeType = "notice-card--info";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Yeni API Endpoint Yetki Rol Ekleme</div>
            <div class="card-body">
                <div class="card-title">
                    <h3 class="text-center title-2">Rol Bilgileri</h3>
                </div>
                <hr>
                <form id="add-new-api-policy-role" asp-controller="DynamicRole" asp-action="Create" method="post">

                    @Html.HiddenFor(x => x.ModelData.DynamicPolicyId)

                    <div class="row mb-3">
                        <div class="col-6">
                            <label asp-for="@Model.ModelData.AllowedRoleId" class="control-label mb-1">Kullanıcı Rolleri</label>
                            <div class="col-12">
                                <select id="api-methode" asp-for="@Model.ModelData.AllowedRoleId" class="form-select">
                                    <option value="GET">GET</option>
                                    <option value="POST">POST</option>
                                    <option value="PUT">PUT</option>
                                    <option value="DELETE">DELETE</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-control-label">Durum</label>
                            <div class="col-12">
                                <div class="form-check form-check-inline">
                                    <input type="radio" id="endpoint-status-active" asp-for="@Model.ModelData.IsActive" value="true" class="form-check-input">
                                    <label asp-for="@Model.ModelData.IsActive" class="form-check-label">Aktif</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" id="endpoint-status-pasive" asp-for="@Model.ModelData.IsActive" value="false" class="form-check-input">
                                    <label asp-for="@Model.ModelData.IsActive" class="form-check-label">Pasif</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-6">
                            <div class="row justify-content-end">
                                <div class="col col-5">
                                    <button id="api-policy-submit" type="submit" class="w-100 btn btn-lg btn-info">
                                        <i class="fa-regular fa-floppy-disk"></i>&nbsp;
                                        <span id="api-policy-submit-amount">Kaydet</span>
                                    </button>
                                </div>
                                <div class="col col-4">
                                    <a href="/dynamicrole/policyid/@Model.ModelData.DynamicPolicyId" id="api-policy-submit" type="button" class="w-100 btn btn-lg btn-outline-secondary">
                                        <i class="fa-regular fa-circle-xmark"></i>&nbsp;
                                        <span id="api-policy-submit-amount">Vazgeç</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>